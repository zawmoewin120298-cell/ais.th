{
    admin off
}

:{$PORT:8080} {
    handle /health {
        respond "OK" 200
    }

    @vless_ws {
        path /vless
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @vless_ws 127.0.0.1:8082

    # OpenResty/Nginx ကို 8880 ပြောင်းထားရင် ဒီမှာလည်း 8880 လို့ ပြောင်းပေးပါ
    reverse_proxy /* 127.0.0.1:8880
}
