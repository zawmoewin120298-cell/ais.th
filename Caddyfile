{
    admin off
}

:{$PORT:8080} {
    # Health check endpoint (Railway / Docker healthcheck အတွက် အဆင်ပြေစေရန်)
    handle /health {
        respond "OK" 200
    }

    # Xray VLESS WebSocket path -> Xray inbound port (ဥပမာ 8082)
    @vless_ws {
        path /vless
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @vless_ws 127.0.0.1:8082

    # ကျန်သော Traffic များ -> OpenResty/Nginx port (ဥပမာ 8081 - 8080 မဟုတ်စေရန်)
    reverse_proxy /* 127.0.0.1:8081
}
